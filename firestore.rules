
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is signed in and verified
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified;
    }

    // Helper function to check if the user is an admin
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Publicly readable collections
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      // Allow creation for any signed-in user
      allow create: if isSignedIn();
      // Allow updates only by the tournament organizer or an admin
      allow update: if isSignedIn() && (resource.data.organizerId == request.auth.uid || isAdmin());
       // Allow deletion only by the tournament organizer or an admin
      allow delete: if isSignedIn() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }

    match /creators/{creatorId} {
      allow read: if true;
      // Only admins can create/delete creators directly.
      // Users are added via applications.
      allow create, delete: if isAdmin();
      // Allow updates only for voting
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy']);
    }
    
    match /creatorApplications/{appId} {
        allow read: if isAdmin() || isOwner(resource.data.userId);
        allow create: if isOwner(request.resource.data.userId);
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

    match /communities/{communityId} {
        allow read: if true;
        allow create: if isSignedIn(); // Any signed-in user can create
        allow update: if isOwner(resource.data.ownerId) || isAdmin();
        allow delete: if isOwner(resource.data.ownerId) || isAdmin();
        
        match /members/{memberId} {
            allow read: if true;
            // Only the user themselves can join (create their member doc)
            // or the community owner/admin can manage members.
            allow create, delete: if isOwner(memberId) || isOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) || isAdmin();
            allow update: if isOwner(memberId) || isOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) || isAdmin();
        }

        match /announcements/{announcementId} {
            allow read: if true;
            allow create, update, delete: if isOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) || isAdmin();
        }
    }

    match /users/{userId} {
      // Allow users to read their own document
      allow read: if isOwner(userId);
      
      // Allow creation only if the user is creating their own document
      allow create: if isOwner(userId);

      // Allow updates only by the user themselves or an admin.
      // Users cannot change their own admin status or points directly.
      allow update: if (isOwner(userId) && !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys())) || isAdmin();
      
      // Allow admins to delete users
      allow delete: if isAdmin();

      // Allow users to read their OWN transaction history
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        // Transactions are created via backend logic (transactions), so no direct client write access.
        allow write: if false; 
      }
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsorships/{sponsorshipId} {
        allow read: if isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
