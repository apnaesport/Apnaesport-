rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
        return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Check a custom claim `isAdmin` on the user's auth token.
      // This is more secure and performant than reading from Firestore.
      // You would set this claim using a Cloud Function or the Firebase Admin SDK.
      return isSignedIn() && request.auth.token.isAdmin == true;
    }

    function isCommunityOwner(communityId, userId) {
        return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == userId;
    }

    function isCommunityMember(communityId, userId) {
        return exists(/databases/$(database)/documents/communities/$(communityId)/members/$(userId));
    }


    // --- Default Security: Deny all access unless explicitly allowed ---
    // This is good practice.
    match /{path=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if isOwner(userId);

      allow update: if (isOwner(userId) && request.resource.data.isAdmin == resource.data.isAdmin) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        allow read: if true;
        allow create: if isVerifiedUser();
        
        allow update: if (isAdmin()) || 
                       (isOwner(resource.data.organizerId) && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['gameId', 'organizerId']))) ||
                       (isVerifiedUser() && request.resource.data.participants.size() == resource.data.participants.size() + 1);

        allow delete: if isAdmin();
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }
    
    // --- Teams (`teams`) ---
    match /teams/{teamId} {
      allow get: if true; 
      allow list: if isSignedIn(); 
      
      allow create: if isVerifiedUser() && request.resource.data.leaderUid == request.auth.uid;
      
      allow update, delete: if isSignedIn() && isTeamLeader(teamId, request.auth.uid);
    }
    
    // --- Direct Messages (`chats`) ---
    match /chats/{chatId} {
        match /messages/{messageId} {
            allow read, create: if isSignedIn() && (request.auth.uid in chatId.split('_'));
            allow delete: if isOwner(resource.data.senderId);
        }
    }

    // --- Communities ---
    match /communities/{communityId} {
        allow get, list: if true;

        allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid;

        // Only the owner can update core details
        allow update: if isVerifiedUser() && isCommunityOwner(communityId, request.auth.uid);
        
        allow delete: if isVerifiedUser() && isCommunityOwner(communityId, request.auth.uid);

        // Community Members Subcollection
        match /members/{memberId} {
            // Community owner can add/remove anyone. User can join/leave.
            allow write: if isVerifiedUser() && (isCommunityOwner(communityId, request.auth.uid) || isOwner(memberId));
            // Anyone can see the list of members
            allow read: if true;
        }

        // Community Posts Subcollection
        match /posts/{postId} {
            allow read: if true;
            // Only members can create posts
            allow create: if isVerifiedUser() && isCommunityMember(communityId, request.auth.uid);
            // Owner can update/delete any post. Author can update/delete their own.
            allow update, delete: if isVerifiedUser() && (isCommunityOwner(communityId, request.auth.uid) || isOwner(resource.data.authorId));
        }
    }
  }
}
