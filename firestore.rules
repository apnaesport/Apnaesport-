
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Collection: games
    // Publicly readable, only admins can write.
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: tournaments
    // Publicly readable. Only admins or tournament organizers can create/update.
    // Deletion is restricted.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || resource.data.organizerId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.organizerId == request.auth.uid);
    }

    // Collection: users
    // Users can read public profiles. They can only create/update their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      // Disallow client-side deletion of user profiles for safety.
      allow delete: if false;

      // Subcollection: transactions
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if true; // Server-side logic handles creation
        allow update, delete: if false;
      }
      
      // Subcollection: unseenWins
      match /unseenWins/{winId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Collection: notifications
    // Users can read their own notifications or public ones. Admins can create.
    match /notifications/{notificationId} {
        allow read: if (resource.data.target == "all_users") || (isSignedIn() && resource.data.targetUserId == request.auth.uid);
        allow create: if isAdmin();
        allow update, delete: if false;
    }

    // Collection: settings
    // Publicly readable for client-side configuration. Only admins can write.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Collection: sponsorships
    // Only admins can read/write. Logged-in users can create.
    match /sponsorships/{sponsorshipId} {
        allow read, write: if isAdmin();
        allow create: if isSignedIn();
    }
    
    // Collection: creators & creatorApplications
    // Publicly readable. Applications can only be created by signed-in users.
    // Management is handled by admins.
    match /creators/{creatorId} {
        allow read: if true;
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
    }
    match /creatorApplications/{applicationId} {
        allow read: if isSignedIn(); // Users can read their own, admins can read all
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
    }
    
    // Collection: communities
    // Publicly readable. Writes are more complex (joining/leaving is handled by backend logic
    // proxied through specific updates).
    match /communities/{communityId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn(); // Logic is handled in store, here we check for auth
        
        // Subcollection: members
        match /members/{memberId} {
            allow read: if true;
            allow create, delete: if isOwner(memberId) || isAdmin(); // User can join/leave
        }
        
        // Subcollection: announcements
        match /announcements/{announcementId} {
            allow read: if true;
            allow create, update, delete: if isSignedIn(); // Handled by community owner check in code
        }
    }
  }
}
