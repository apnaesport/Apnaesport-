
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Checks if a user is signed in and their email is verified.
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // A more secure check to ensure the user is updating their own document.
    function isSelf(userId) {
        return isSignedIn() && request.auth.uid == userId;
    }

    // Retrieves a user's data from their profile.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Checks if the current user is an admin.
    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).isAdmin == true;
    }
    
    // Checks if the current user is the organizer of a specific tournament.
    function isTournamentOrganizer(tournamentId) {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }

    // Checks if the current user is the owner of a specific community.
    function isCommunityOwner(communityId) {
      let ownerId = get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId;
      return isSignedIn() && request.auth.uid == ownerId;
    }
    
    // --- Default Security Rule ---
    // By default, deny all read and write access to all documents.
    // This ensures that we must explicitly grant permission for any action.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      // Allow anyone to read public user profiles.
      // This is needed for displaying participant names, leaderboards, etc.
      allow read: if true;

      // Allow a user to create their own profile document.
      // They must be creating a document that matches their own UID.
      // They cannot grant themselves admin privileges or set custom points on creation.
      allow create: if isSelf(userId)
                    && request.resource.data.isAdmin == false
                    && request.resource.data.points == 10
                    && !('communityId' in request.resource.data);
      
      // Allow a user to update their own profile, but not critical fields.
      // Admins can update any profile but cannot change their own admin status.
      allow update: if (isSelf(userId) && !('isAdmin' in request.resource.data || 'points' in request.resource.data || 'apnaId' in request.resource.data)) || 
                     (isAdmin() && (userId != request.auth.uid || !('isAdmin' in request.resource.data)));
      
      // Only an admin can delete a user account.
      allow delete: if isAdmin();
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      // Game data is public and must be readable by everyone for browsing.
      allow read: if true;
      // Only admins can create, update, or delete games.
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        // Tournament data is public and must be readable by everyone.
        // This is critical for the dashboard and tournament list pages.
        allow read: if true;
        
        // A signed-in user can create a tournament if they have enough points.
        allow create: if isSignedIn() && getUserData(request.auth.uid).points >= 40;
        
        // Complex update logic for tournaments.
        allow update: if isSignedIn() && (
            // Admins can update anything.
            isAdmin() ||
            
            // Tournament organizers can update specific non-critical fields.
            (isTournamentOrganizer(tournamentId) && 
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizerId', 'gameId', 'prizePool', 'entryFee', 'participants', 'winners', 'createdAt', 'status'])) ||

            // A signed-in user can join a tournament by adding themselves to the participants list.
            // This is a secure transactional update that also increments the prize pool.
            (
                request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
                request.resource.data.participants[request.resource.data.participants.size() - 1].id == request.auth.uid &&
                request.resource.data.prizePool == resource.data.prizePool + resource.data.entryFee &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'prizePool', 'updatedAt'])
            )
        );
        
        // An organizer or an admin can delete a tournament.
        allow delete: if isSignedIn() && (isAdmin() || isTournamentOrganizer(tournamentId));
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        // Notifications are public for all users to see announcements.
        allow read: if true;
        // Only admins can create/write notifications.
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        // Site settings are public and must be readable by everyone.
        allow read: if true;
        // Only admins can change site settings.
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      // Any signed-in user can create a request.
      allow create: if isSignedIn();
      // Only admins can read, update status, or delete requests.
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      // Community pages are public and readable by anyone.
      allow read: if true;

      // A signed-in user can create a community, setting themself as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Community owners or admins can update details.
      // Other users can join, which only increments the member count.
      allow update: if isSignedIn() && (
        (isAdmin() || isCommunityOwner(communityId)) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) && 
          request.resource.data.memberCount == resource.data.memberCount + 1
        )
      );
      
      // Only the community owner or an admin can delete the community.
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // --- Community Members (`members`) ---
      match /members/{userId} {
        // Allow anyone to see the list of community members.
        allow read: if true;
        // A user can create their own member document when joining.
        allow create: if isSelf(userId);
        // A user can leave, or an owner can kick a member.
        allow delete: if isSelf(userId) || isCommunityOwner(communityId);
        // Only the owner or an admin can update member details (e.g., change roles).
        allow update: if isAdmin() || isCommunityOwner(communityId);
      }

      // --- Community Announcements (`announcements`) ---
      match /announcements/{announcementId} {
        // Announcements are public within a community.
        allow read: if true;
        // Only the owner can write (create, update, delete) announcements.
        allow write: if isCommunityOwner(communityId);
      }
    }
    
    // --- Creator Hub (`creatorApplications` and `creators`) ---
    match /creatorApplications/{applicationId} {
      // A user can create their own application.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // An admin can read any application. A user can read their own.
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      // Only admins can update or delete applications.
      allow update, delete: if isAdmin();
    }
    
    match /creators/{creatorId} {
      // Creator profiles are public.
      allow read: if true;
      // Only admins can create (approve) or delete creator profiles.
      allow create, delete: if isAdmin();
      // An admin can update any field. A user can vote securely.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.votes == resource.data.votes + 1 &&
          // Ensure the user has not already voted.
          !resource.data.votedBy.hasAny([request.auth.uid]) && 
          // Ensure only 'votes' and 'votedBy' fields are being changed.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy', 'updatedAt'])
        )
      );
    }
  }
}
