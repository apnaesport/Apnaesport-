
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user is an admin by reading their user document.
      // This is secure because it relies on trusted server data.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    // WARNING: These rules are insecure and for development only.
    // They allow anyone to read and write to any user's profile.
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      // Game data is public and can be read by anyone.
      allow read: if true;
      // Only admins can create, update, or delete games.
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    // WARNING: These rules are insecure and for development only.
    // They allow anyone to create, read, update, or delete tournaments.
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        // Notifications are public for simplicity, but only admins can write.
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        // Site settings are public.
        allow read: if true;
        // Only admins can change site settings.
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      // Any signed in user can create a request.
      allow create: if isSignedIn();
      // Only admins can read, update status, or delete requests.
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      // Community data is public.
      allow read: if true;

      // Only signed-in users can create a community.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Admins and community owners can update.
      allow update: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // Admins and community owners can delete.
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // --- Community Members (`members`) ---
      match /members/{userId} {
        allow read: if true;
        allow create: if isSelf(userId);
        allow delete: if isSelf(userId) || isCommunityOwner(communityId);
        allow update: if isAdmin() || isCommunityOwner(communityId);
      }

      // --- Community Announcements (`announcements`) ---
      match /announcements/{announcementId} {
        allow read: if true;
        allow write: if isCommunityOwner(communityId);
      }
    }
    
    // --- Creator Hub (`creatorApplications` and `creators`) ---
    match /creatorApplications/{applicationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
    match /creators/{creatorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Voting is allowed for signed-in users.
      allow update: if isSignedIn();
    }
  }
}
