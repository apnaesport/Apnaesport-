rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // A more secure check to ensure the user is updating their own document
    function isSelf(userId) {
        return request.auth.uid == userId;
    }

    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin;
    }

    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == true;
    }
    
    function isTournamentOrganizer(tournamentId) {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }

    function isCommunityOwner(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      // Anyone can read public profile data (get) or list all users for leaderboards
      allow get, list: if true;

      // A user can create their own profile document, but cannot make themselves an admin on creation.
      // This rule ensures the document ID matches the authenticated user's ID.
      allow create: if request.auth.uid == userId && request.resource.data.isAdmin == false;
      
      // A user can update their own profile, but cannot change their admin status.
      // An admin can update any profile.
      allow update: if (isSelf(userId) && request.resource.data.isAdmin == resource.data.isAdmin) || isAdmin();
      
      // Only an admin can delete a user account
      allow delete: if isAdmin();
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      // Game data is public
      allow read: if true;
      // Only admins can create, update, or delete games
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        // Tournament data is public
        allow read: if true;
        
        // Signed-in users can create tournaments
        allow create: if isSignedIn();
        
        // Admins can update anything. Organizers can update their own tournament. 
        // Any signed-in user can join if they are ONLY adding themself to the participants list.
        allow update: if isSignedIn() && (
            isAdmin() || 
            (isTournamentOrganizer(tournamentId) && request.resource.data.organizerId == resource.data.organizerId && request.resource.data.gameId == resource.data.gameId) ||
            (request.resource.data.participants.size() == resource.data.participants.size() + 1 && request.auth.uid in request.resource.data.participants.map(p => p.id))
        );
        
        // Only admins or the organizer can delete tournaments.
        allow delete: if isSignedIn() && (isAdmin() || isTournamentOrganizer(tournamentId));
    }
    
    // --- Creator Applications (`creatorApplications`) ---
    match /creatorApplications/{applicationId} {
      // User can create their own application.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      // Only admins can read, update, or delete applications.
      allow read, update, delete: if isAdmin();
    }

    // --- Creators (`creators`) ---
    match /creators/{creatorId} {
      // Anyone can view creators.
      allow read: if true;

      // Only admins can add or remove creators.
      allow create, delete: if isAdmin();

      // Admins can update anything.
      // A user can update a creator document ONLY for voting.
      function isVoting() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(['votes', 'votedBy', 'updatedAt'])
               && request.resource.data.votes == resource.data.votes + 1
               && request.resource.data.votedBy.hasAny([request.auth.uid])
               && !resource.data.votedBy.hasAny([request.auth.uid]);
      }
      allow update: if isAdmin() || (isSignedIn() && isVoting());
    }

    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        // Any signed-in user can read notifications
        allow read: if isSignedIn();
        // Only admins can create/write notifications
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        // Site settings are public
        allow read: if true;
        // Only admins can change site settings
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      // Any signed in user can create a request
      allow create: if isSignedIn();
      // Only admins can read, update status, or delete requests
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      // Anyone can view a community's public page
      allow read: if true;

      // A signed-in user can create a community.
      // Must set themself as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Community owner or a platform admin can update details.
      // Any user can update the community IF they are ONLY incrementing the member count by 1.
      allow update: if isSignedIn() && (
        (isAdmin() || isCommunityOwner(communityId)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) && request.resource.data.memberCount == resource.data.memberCount + 1)
      );
      
      // Only the community owner or a platform admin can delete the community
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // --- Community Members (`members`) ---
      match /members/{userId} {
        // Anyone can see who is in the community
        allow read: if true;

        // A user can join a community (create their own member doc)
        allow create: if isSignedIn() && isSelf(userId);
        
        // A user can leave a community (delete their own member doc)
        // Community owners can also remove (kick) members
        allow delete: if isSignedIn() && (isSelf(userId) || isCommunityOwner(communityId));

        // Roles and other details can only be updated by the community owner or an admin
        allow update: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      }
    }
  }
}
