
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).isAdmin == true;
    }
    
    function isTournamentOrganizer(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }

    function isCommunityOwner(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }
    
    // --- Default Security: Deny all by default ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Publicly Readable Collections ---
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isSignedIn() && getUserData(request.auth.uid).points >= 40;
      allow update: if isSignedIn() && (isAdmin() || isTournamentOrganizer(tournamentId));
      allow delete: if isSignedIn() && (isAdmin() || isTournamentOrganizer(tournamentId));
    }

    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /creators/{creatorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.votes == resource.data.votes + 1 &&
          request.resource.data.votedBy == resource.data.votedBy.concat([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy', 'updatedAt'])
        )
      );
    }
    
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
    }
    
    match /communities/{communityId}/members/{userId} {
      allow read: if true;
      allow create: if isSelf(userId);
      allow delete: if isSelf(userId) || isCommunityOwner(communityId);
      allow update: if isAdmin() || isCommunityOwner(communityId);
    }
    
    match /communities/{communityId}/announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn() && isCommunityOwner(communityId);
    }

    // --- Private & Semi-Private Collections ---
    match /users/{userId} {
      allow get: if true; // Allow anyone to get a single user's public profile
      allow list: if isAdmin(); // Only admins can list all users

      // A verified user can create their own profile document.
      allow create: if isSelf(userId) && request.resource.data.emailVerified == true;
      
      // Update rules:
      // 1. A user can update their own profile, but cannot change protected fields.
      // 2. An admin can update any profile.
      allow update: if (isSelf(userId) && !('isAdmin' in request.resource.data || 'points' in request.resource.data || 'apnaId' in request.resource.data)) || isAdmin();
      
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /sponsorships/{sponsorshipId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    
    match /creatorApplications/{applicationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
