
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).isAdmin == true;
    }
    
    function getTournamentData(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
    }

    function isTournamentOrganizer(tournamentId) {
      return isSignedIn() && getTournamentData(tournamentId).organizerId == request.auth.uid;
    }

    function getCommunityData(communityId) {
       return get(/databases/$(database)/documents/communities/$(communityId)).data;
    }

    function isCommunityOwner(communityId) {
      return isSignedIn() && getCommunityData(communityId).ownerId == request.auth.uid;
    }

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      // Anyone can read public profile data (get) or list all users.
      allow get, list: if true;

      // A user can create their own profile document.
      // - Must match the authenticated user's ID.
      // - Cannot make themselves an admin or set points/community on creation.
      allow create: if isSelf(userId)
                    && request.resource.data.isAdmin == false
                    && request.resource.data.points == 10
                    && !('communityId' in request.resource.data);
      
      // A user can update their own profile, but CANNOT change their role, points, or ID.
      // An admin can update any profile, but not change their own admin status.
      allow update: if (isSelf(userId) && !('isAdmin' in request.resource.data) && !('points' in request.resource.data) && !('apnaId' in request.resource.data)) || 
                     (isAdmin() && (userId != request.auth.uid || !('isAdmin' in request.resource.data)));
      
      // Only an admin can delete a user account
      allow delete: if isAdmin();
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      // Game data is public.
      allow read: if true;
      // Only admins can create, update, or delete games.
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        // Tournament data is public.
        allow read: if true;
        
        // Signed-in users can create tournaments if they have enough points (checked in transaction).
        allow create: if isSignedIn() && request.resource.data.organizerId == request.auth.uid;
        
        // --- Complex Update Logic for Tournaments ---
        allow update: if isSignedIn() && (
            // 1. Admins can do anything.
            isAdmin() ||
            
            // 2. Tournament organizers can update non-critical fields.
            (
              isTournamentOrganizer(tournamentId) &&
              // Prevent organizer from changing key fields after creation
              request.resource.data.organizerId == resource.data.organizerId &&
              request.resource.data.gameId == resource.data.gameId &&
              request.resource.data.entryFee == resource.data.entryFee &&
              // Allow prize pool to be changed ONLY if it's an increase from their own points (handled in backend)
              // This rule is simplified to allow most organizer updates. More specific checks are in transactions.
              !('participants' in request.resource.data.diff(resource.data).affectedKeys()) // Organizer cannot directly edit participants list
            ) ||

            // 3. Any signed-in user can join a tournament if the rules are met.
            (
              // User is adding exactly one participant.
              request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
              // The new participant being added is the current user.
              request.resource.data.participants[resource.data.participants.size()].id == request.auth.uid &&
              // The prize pool must increase by exactly the entry fee.
              request.resource.data.prizePool == resource.data.prizePool + resource.data.entryFee &&
              // No other fields can be changed.
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'prizePool', 'updatedAt'])
            )
        );
        
        // Organizer or admin can delete.
        allow delete: if isSignedIn() && (isAdmin() || isTournamentOrganizer(tournamentId));
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        allow read: if true; // Public announcements
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Admin or Owner can update. Users can only join/leave (which increments/decrements memberCount).
      allow update: if isSignedIn() && (
        (isAdmin() || isCommunityOwner(communityId)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) && 
         (request.resource.data.memberCount == resource.data.memberCount + 1 || request.resource.data.memberCount == resource.data.memberCount - 1))
      );
      
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      match /members/{userId} {
        allow read: if true;
        allow create: if isSelf(userId);
        allow delete: if isSelf(userId) || isCommunityOwner(communityId);
        allow update: if isAdmin() || isCommunityOwner(communityId);
      }

      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isCommunityOwner(communityId);
      }
    }
    
    // --- Creator Hub ---
    match /creatorApplications/{applicationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
    match /creators/{creatorId} {
      allow get, list: if true;
      allow create, delete: if isAdmin();
      
      // Allow secure voting by users.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.votes == resource.data.votes + 1 &&
          // Ensure the user's ID is being added to votedBy and wasn't there before.
          !resource.data.votedBy.hasAny([request.auth.uid]) &&
          request.resource.data.votedBy == resource.data.votedBy.concat([request.auth.uid]) &&
          // Ensure only votes and votedBy are changing.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy', 'updatedAt'])
        )
      );
    }
  }
}
