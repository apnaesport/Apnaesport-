rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Checks if a user is signed in and their email is verified.
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Checks if the requesting user is the owner of a specific document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A more secure check to ensure the user is updating their own document.
    function isSelf(userId) {
        return request.auth.uid == userId;
    }

    // Retrieves a user's role from their profile.
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin;
    }

    // Checks if the current user is an admin.
    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == true;
    }
    
    // Checks if the current user is the organizer of a specific tournament.
    function isTournamentOrganizer(tournamentId) {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }

    // Checks if the current user is the owner of a specific community.
    function isCommunityOwner(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      // Anyone can read public profile data (e.g., for leaderboards or participant lists).
      // `read` covers both `get` (single document) and `list` (collection query).
      allow read: if true;

      // A user can create their own profile document.
      // - Must match the authenticated user's ID.
      // - Cannot make themselves an admin or set points/community on creation.
      allow create: if isSelf(userId)
                    && request.resource.data.isAdmin == false
                    // Ensure points can only be set to the default signup bonus on creation.
                    && request.resource.data.points == 10
                    && !('communityId' in request.resource.data);
      
      // A user can update their own profile, but cannot change their role, points, or other critical fields.
      // An admin can update any profile, but not demote themselves if they are the primary admin.
      allow update: if (isSelf(userId) && !('isAdmin' in request.resource.data || 'points' in request.resource.data || 'apnaId' in request.resource.data)) || 
                     (isAdmin() && (userId != request.auth.uid || !('isAdmin' in request.resource.data)));
      
      // Only an admin can delete a user account.
      allow delete: if isAdmin();
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      // Game data is public and readable by anyone.
      allow read: if true;
      // Only admins can create, update, or delete games.
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        // Tournament data is public and readable by anyone.
        allow read: if true;
        
        // Signed-in users can create tournaments if they have enough points.
        allow create: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.points >= 40;
        
        // Complex update logic for tournaments.
        allow update: if isSignedIn() && (
            // Condition 1: Admins can update anything.
            isAdmin() ||
            
            // Condition 2: Tournament organizers can update specific non-critical fields.
            // They cannot change the organizer, game, prize pool, entry fee, or participants list directly.
            (isTournamentOrganizer(tournamentId) && 
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizerId', 'gameId', 'prizePool', 'entryFee', 'participants', 'winners'])) ||

            // Condition 3: Any signed-in user can join a tournament.
            // This is a secure transactional check for adding a participant.
            (
                // The new participants array must be exactly one larger than the old one.
                request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
                // The new participant being added must be the currently authenticated user.
                request.resource.data.participants[request.resource.data.participants.size() - 1].id == request.auth.uid &&
                // The prize pool must be correctly incremented by the entry fee.
                request.resource.data.prizePool == resource.data.prizePool + resource.data.entryFee &&
                // No other fields besides participants, prizePool, and the update timestamp can be changed.
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'prizePool', 'updatedAt'])
            )
        );
        
        // Organizer or admin can delete a tournament.
        allow delete: if isSignedIn() && (isAdmin() || isTournamentOrganizer(tournamentId));
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        // Any signed-in user can read notifications.
        allow read: if isSignedIn();
        // Only admins can create/write notifications.
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        // Site settings are public and readable by anyone.
        allow read: if true;
        // Only admins can change site settings.
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      // Any signed-in user can create a request.
      allow create: if isSignedIn();
      // Only admins can read, update status, or delete requests.
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      // Anyone can view a community's public page.
      allow read: if true;

      // A signed-in user can create a community, setting themself as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Community owner or a platform admin can update details.
      // Other users can join, which only increments member count.
      allow update: if isSignedIn() && (
        (isAdmin() || isCommunityOwner(communityId)) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) && 
          request.resource.data.memberCount == resource.data.memberCount + 1
        )
      );
      
      // Only the community owner or a platform admin can delete the community.
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // --- Community Members (`members`) ---
      match /members/{userId} {
        // Anyone can see who is in the community.
        allow read: if true;
        // A user can join a community (create their own member doc).
        allow create: if isSelf(userId);
        // A user can leave a community (delete their own member doc).
        // The community owner can also remove (kick) members.
        allow delete: if isSelf(userId) || isCommunityOwner(communityId);
        // Roles and other details can only be updated by the community owner or an admin.
        allow update: if isAdmin() || isCommunityOwner(communityId);
      }

      // --- Community Announcements (`announcements`) ---
      match /announcements/{announcementId} {
        // Announcements are public.
        allow read: if true;
        // Only the owner can create, update, or delete announcements.
        allow write: if isCommunityOwner(communityId);
      }
    }
    
    // --- Creator Hub (`creatorApplications` and `creators`) ---
    match /creatorApplications/{applicationId} {
      // A user can create their own application.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // An admin can read any application. A user can read their own.
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      // Only admins can update status or delete applications.
      allow update, delete: if isAdmin();
    }
    
    match /creators/{creatorId} {
      // Anyone can view the list of approved creators.
      allow read: if true;
      // Only admins can create (approve) or delete creator profiles.
      allow create, delete: if isAdmin();
      // An admin can update any field.
      // A signed-in user can vote securely.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.votes == resource.data.votes + 1 &&
          // Ensure the user is not already in the votedBy array.
          !resource.data.votedBy.hasAny([request.auth.uid]) && 
          // Ensure only votes and votedBy are being changed.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy', 'updatedAt'])
        )
      );
    }
  }
}
