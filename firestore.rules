rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin;
    }

    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == true;
    }
    
    function isTournamentOrganizer(tournamentId) {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid;
    }
    
    function isJoiningTournament() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']);
    }

    function isCommunityOwner(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }
    
    // Checks if the only field being changed by a user is their own communityId
    function isChangingOwnCommunityId() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['communityId', 'updatedAt']);
    }

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      // Anyone can read public profile data (get) or list all users for leaderboards
      allow get, list: if true;

      // A user can create their own profile document, but cannot make themselves an admin on creation
      allow create: if isOwner(userId) && request.resource.data.isAdmin == false;
      
      // A user can update their own profile (and not make themselves an admin).
      // A user is also allowed to ONLY change their own communityId (for joining/leaving).
      // An admin can update any profile.
      allow update: if (isOwner(userId) && (request.resource.data.isAdmin == resource.data.isAdmin || isChangingOwnCommunityId())) || isAdmin();
      
      // Only an admin can delete a user account
      allow delete: if isAdmin();
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      // Game data is public
      allow read: if true;
      // Only admins can create, update, or delete games
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        // Tournament data is public
        allow read: if true;
        
        // Signed-in users can create tournaments
        allow create: if isSignedIn();
        
        // Admins can update anything.
        // Organizers can update their own tournament (but not critical fields).
        // Any signed-in user can join a tournament by updating only the participants list.
        allow update: if isSignedIn() && (
            isAdmin() || 
            (isTournamentOrganizer(tournamentId) && request.resource.data.organizerId == resource.data.organizerId && request.resource.data.gameId == resource.data.gameId) ||
            isJoiningTournament()
        );
        
        // Only admins can delete tournaments to prevent data loss for participants.
        allow delete: if isAdmin();
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        // Any signed-in user can read notifications
        allow read: if isSignedIn();
        // Only admins can create/write notifications
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/global {
        // Site settings are public
        allow read: if true;
        // Only admins can change site settings
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      // Any signed in user can create a request
      allow create: if isSignedIn();
      // Only admins can read, update status, or delete requests
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      // Anyone can view a community's public page
      allow read: if true;

      // A signed-in user can create a community.
      // The user's communityId is checked on the client and in the user update rule.
      // Must set themself as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Only the community owner or a platform admin can update details
      allow update: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // Only the community owner or a platform admin can delete the community
      allow delete: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      
      // --- Community Members (`members`) ---
      match /members/{userId} {
        // Anyone can see who is in the community
        allow read: if true;

        // A user can join a community (create their own member doc)
        // Community owners can also add members
        allow create: if isSignedIn() && (isOwner(userId) || isCommunityOwner(communityId));
        
        // A user can leave a community (delete their own member doc)
        // Community owners can also remove members
        allow delete: if isSignedIn() && (isOwner(userId) || isCommunityOwner(communityId));

        // Roles and other details can only be updated by the community owner or an admin
        allow update: if isSignedIn() && (isAdmin() || isCommunityOwner(communityId));
      }
    }
  }
}
