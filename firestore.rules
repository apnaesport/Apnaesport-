
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Checks if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the requesting user's email is verified.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // A secure check to ensure the user is updating their own document.
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Retrieves user data.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Checks if the current user is an admin.
    function isAdmin() {
      return isVerified() && getUserData(request.auth.uid).isAdmin == true;
    }

    // Checks if the current user is the organizer of a specific tournament.
    function isTournamentOrganizer(tournamentId) {
      // Use resource.data for create/update rules on the tournament itself.
      // Use get() for rules on other documents that need to reference the tournament.
      let tournamentData = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      return isVerified() && tournamentData.organizerId == request.auth.uid;
    }
    
    // Checks if the user is the organizer based on incoming request data.
    function isRequestingOrganizer() {
        return isVerified() && request.resource.data.organizerId == request.auth.uid;
    }

    // Checks if the current user is the owner of a specific community.
    function isCommunityOwner(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles (`users`) ---
    match /users/{userId} {
      // Anyone can read public profile data.
      allow read: if true;

      // A user can create their own profile document.
      allow create: if isSelf(userId)
                    && request.resource.data.isAdmin == false
                    && request.resource.data.points == 10
                    && !('communityId' in request.resource.data)
                    && request.resource.data.uid == userId;
      
      // Update rules for user profiles.
      allow update: if isVerified() && (
        // Admins can update specific fields on any profile.
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'apnaId', 'createdAt', 'uid'])) ||
        // A user can update their own profile, but not protected fields.
        (isSelf(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isPremium', 'premiumSince', 'hasReceivedPremiumBonus', 'points', 'apnaId', 'createdAt', 'uid'])
        ) ||
        // A user can update their points for a daily bonus claim.
        (isSelf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastBonusClaimedAt', 'points', 'updatedAt']) &&
          request.resource.data.points == resource.data.points + 5
        )
      );
      
      allow delete: if isAdmin();

      // Transaction subcollection rules.
      match /transactions/{transactionId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId) || isAdmin();
        allow update, delete: if false;
      }
    }

    // --- Games (`games`) ---
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Tournaments (`tournaments`) ---
    match /tournaments/{tournamentId} {
        // ANYONE can read tournament data for dashboards and lists.
        allow read: if true;

        // CREATE: A verified user can create a tournament if they meet conditions.
        allow create: if isVerified() && isRequestingOrganizer() && (
            // Standard tournament creation: must have enough points.
            (
              (!request.resource.data.isQuickTournament || request.resource.data.isQuickTournament == false) &&
              getUserData(request.auth.uid).points >= 40
            ) ||
            // Quick tournament creation: must be the owner of the target community.
            (
              request.resource.data.isQuickTournament == true &&
              isCommunityOwner(request.resource.data.communityId)
            )
        );

        // UPDATE: Different roles can update different things.
        allow update: if isVerified() && (
            // ADMINS can update any tournament.
            isAdmin() ||

            // ORGANIZER can manage their own tournament.
            (isTournamentOrganizer(tournamentId) && (
                // Scenario 1: Updating room details
                request.resource.data.diff(resource.data).affectedKeys().hasAny(['roomCode', 'roomPassword', 'updatedAt'])
                ||
                // Scenario 2: Ending the tournament and awarding winners.
                (
                  request.resource.data.status == "Completed" &&
                  request.resource.data.winners.size() > 0 &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winners', 'updatedAt'])
                )
            )) ||

            // ANY VERIFIED USER can join a tournament.
            (
                resource.data.status == "Upcoming" && // Can only join upcoming tournaments
                request.resource.data.participants.size() == resource.data.participants.size() + 1 && // Only adding one participant
                request.resource.data.participants[request.resource.data.participants.size() - 1].id == request.auth.uid && // The participant is the current user
                getUserData(request.auth.uid).points >= resource.data.entryFee && // User has enough points
                // Only participants and prizePool can change during a join operation.
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'prizePool', 'updatedAt'])
            ) ||
            
            // ANYONE can trigger a status update (e.g. from Upcoming to Live).
            // This is a safe operation needed for the automated status checker.
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
        );

        // DELETE: Only the organizer or an admin can delete.
        allow delete: if isVerified() && (isAdmin() || isTournamentOrganizer(tournamentId));
    }
    
    // --- Notifications (`notifications`) ---
    match /notifications/{notificationId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // --- Site Settings (`settings`) ---
    match /settings/{setting} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    // --- Sponsorships (`sponsorships`) ---
    match /sponsorships/{sponsorshipId} {
      allow create: if isVerified();
      allow read, update, delete: if isAdmin();
    }
    
    // --- Communities (`communities`) ---
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isVerified() && (
        (isAdmin() || isCommunityOwner(communityId)) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) && 
          request.resource.data.memberCount == resource.data.memberCount + 1
        )
      );
      allow delete: if isVerified() && (isAdmin() || isCommunityOwner(communityId));
      
      match /members/{userId} {
        allow read: if true;
        allow create: if isSelf(userId);
        allow delete: if isSelf(userId) || isCommunityOwner(communityId);
        allow update: if isAdmin() || isCommunityOwner(communityId);
      }

      match /announcements/{announcementId} {
        allow read: if true;
        allow write: if isCommunityOwner(communityId);
      }
    }
    
    // --- Creator Hub (`creatorApplications` and `creators`) ---
    match /creatorApplications/{applicationId} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow read: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
    match /creators/{creatorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isVerified() && (
        isAdmin() ||
        (
          request.resource.data.votes == resource.data.votes + 1 &&
          !resource.data.votedBy.hasAny([request.auth.uid]) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votedBy', 'updatedAt'])
        )
      );
    }
  }
}
