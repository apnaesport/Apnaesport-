rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isPremium() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true;
    }
    
    function getGame(gameId) {
        return get(/databases/$(database)/documents/games/$(gameId));
    }
    
    function getTournament(tournamentId) {
        return get(/databases/$(database)/documents/tournaments/$(tournamentId));
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read a user's public profile
      allow get: if true;
      
      // A user can create their own profile
      allow create: if isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.points == 10;
                       
      // A user can only update their own profile with specific fields
      allow update: if isOwner(userId) || isAdmin();
      
      // Nobody can delete user profiles
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin(); // Only admins can create/modify transactions directly
      }
    }
    
    // Games Collection
    match /games/{gameId} {
      // Anyone can read the list of games
      allow read: if true;
      // Only admins can create, update, or delete games
      allow write: if isAdmin();
    }
    
    // Tournaments Collection
    match /tournaments/{tournamentId} {
      // Anyone can read a tournament's details
      allow get, list: if true;
      
      // Authenticated users can create tournaments
      allow create: if isUserAuthenticated();
      
      // Only the organizer or an admin can update or delete
      allow update, delete: if isOwner(resource.data.organizerId) || isAdmin();
    }
    
    // Settings Collection
    match /settings/{docId} {
        allow get: if true;
        allow write: if isAdmin();
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
        allow read: if isUserAuthenticated();
        allow write: if isAdmin();
    }

    // Sponsorships Collection
    match /sponsorships/{sponsorshipId} {
      allow create: if isUserAuthenticated();
      allow read, update, delete: if isAdmin();
    }
    
    // Communities Collection
    match /communities/{communityId} {
      allow get, list: if true;
      allow create: if isUserAuthenticated();
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
      
      match /members/{memberId} {
        allow read: if true;
        allow create: if isOwner(memberId);
        allow delete: if isOwner(memberId) || isOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId);
      }
      
      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId);
      }
    }

    // Creator Hub Collections
    match /creators/{creatorId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }

    match /creatorApplications/{applicationId} {
        allow read: if isUserAuthenticated();
        allow create: if isOwner(request.resource.data.userId);
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
    
    // Premium Requests Collection
    match /premiumRequests/{requestId} {
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}